# -----------------------------------------------------------------------------
# Web Information
# -----------------------------------------------------------------------------
NEXT_PUBLIC_WEB_URL = "http://localhost:3000"
NEXT_PUBLIC_PROJECT_NAME = "ShipAny"

# -----------------------------------------------------------------------------
# Database with Supabase (shared project with Face Rating; isolated schema)
# Face Rating uses public.*; this app uses imagetocad.*
# https://supabase.com/docs/guides/getting-started/quickstarts/nextjs
DATABASE_URL = ""
DIRECT_URL = ""
DATABASE_SCHEMA = "imagetocad"

# -----------------------------------------------------------------------------
# Auth with next-auth
# https://authjs.dev/getting-started/installation?framework=Next.js
# Set your Auth URL and Secret
# Secret can be generated with `openssl rand -base64 32`
# -----------------------------------------------------------------------------
AUTH_SECRET = "Zt3BXVudzzRq2R2WBqhwRy1dNMq48Gg9zKAYq7YwSL0="
AUTH_URL = "http://localhost:3000/api/auth"
AUTH_TRUST_HOST = true

# disable auth if needed
# NEXT_PUBLIC_AUTH_ENABLED = "false"

# Google Auth
# https://authjs.dev/getting-started/providers/google
AUTH_GOOGLE_ID = ""
AUTH_GOOGLE_SECRET = ""
NEXT_PUBLIC_AUTH_GOOGLE_ID = ""
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED = "false"
NEXT_PUBLIC_AUTH_GOOGLE_ONE_TAP_ENABLED = "false"

# Github Auth
# https://authjs.dev/getting-started/providers/github
AUTH_GITHUB_ID = ""
AUTH_GITHUB_SECRET = ""
NEXT_PUBLIC_AUTH_GITHUB_ENABLED = "false"

# -----------------------------------------------------------------------------
# Passwordless email login (magic link) — thefacereport-style
# Enter email → receive one-click link → session
# NEXT_PUBLIC_AUTH_EMAIL_ENABLED = "true" to force UI on; "false" to hide
# -----------------------------------------------------------------------------
NEXT_PUBLIC_AUTH_EMAIL_ENABLED = "true"

# Email: login magic link + paid report URL (Resend default)
# Free tier ~100/day · ~3000/month — https://resend.com/pricing
EMAIL_TRANSPORT = "resend"
RESEND_API_KEY = ""
# IMPORTANT for Gmail inbox (not Spam):
# 1) Resend → Domains → Add face-rating.app → add SPF + DKIM (+ DMARC) DNS records
# 2) Wait until domain status is Verified
# 3) Use a from-address on THAT domain (never long-term onboarding@resend.dev)
# Dev only (shared test domain → often lands in Spam):
# RESEND_SENDER_EMAIL = "Face Rating <onboarding@resend.dev>"
# EMAIL_FROM = "Face Rating <onboarding@resend.dev>"
RESEND_SENDER_EMAIL = "Face Rating <noreply@face-rating.app>"
EMAIL_FROM = "Face Rating <noreply@face-rating.app>"
# Optional: where replies go
# EMAIL_REPLY_TO = "support@face-rating.app"

# Optional ZeptoMail fallback
# EMAIL_TRANSPORT = "zeptomail"
# ZEPTOMAIL_TOKEN = ""

# -----------------------------------------------------------------------------
# Analytics with Google Analytics
# https://analytics.google.com
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID = ""

# -----------------------------------------------------------------------------
# Analytics with OpenPanel
# https://openpanel.dev
# -----------------------------------------------------------------------------
NEXT_PUBLIC_OPENPANEL_CLIENT_ID = ""

# Analytics with Plausible
# https://plausible.io/
NEXT_PUBLIC_PLAUSIBLE_DOMAIN = ""
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL = ""

# Microsoft Clarity — https://clarity.microsoft.com
# Server runtime (recommended on VPS/Docker). Falls back to NEXT_PUBLIC_.
CLARITY_PROJECT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# -----------------------------------------------------------------------------
# Payment with Stripe
# https://docs.shipany.ai/features/payment/stripe
# -----------------------------------------------------------------------------
STRIPE_PUBLIC_KEY = ""
STRIPE_PRIVATE_KEY = ""
STRIPE_WEBHOOK_SECRET = ""
# Full Face Report one-time ($9.90) — Stripe Price ID
STRIPE_FACE_REPORT_PRICE_ID = ""
# image to cad credit packs and plans
STRIPE_STARTER_PACK_PRICE_ID = ""
STRIPE_POPULAR_PACK_PRICE_ID = ""
