# -----------------------------------------------------------------------------
# Payment with Creem
# https://docs.shipany.ai/features/payment/creem
# -----------------------------------------------------------------------------
CREEM_ENV = ""
CREEM_API_KEY = ""
CREEM_WEBHOOK_SECRET = ""
CREEM_PRODUCTS = ''

PAY_PROVIDER = "stripe"

NEXT_PUBLIC_PAY_SUCCESS_URL = "/dashboard"
NEXT_PUBLIC_PAY_FAIL_URL = "/pricing"
NEXT_PUBLIC_PAY_CANCEL_URL = "/pricing"

NEXT_PUBLIC_LOCALE_DETECTION = "false"

ADMIN_EMAILS = ""

NEXT_PUBLIC_DEFAULT_THEME = "system"

# -----------------------------------------------------------------------------
# Kie.ai — images + LLM
# https://kie.ai/api-key
# GPT Image 2: https://kie.ai/gpt-image-2
# Gemini 2.5 Flash (Chapter / AI Notes): https://kie.ai/gemini-2.5-flash
# Docs: https://docs.kie.ai/market/gemini/gemini-2-5-flash
# -----------------------------------------------------------------------------
KIE_API_KEY=
# Optional override (default https://api.kie.ai)
# KIE_API_BASE=https://api.kie.ai
# Optional completion webhook, e.g. https://face-rating.app/api/kie/callback
# KIE_CALLBACK_URL=

# -----------------------------------------------------------------------------
# Replicate — incredibly-fast-whisper transcription
# https://replicate.com/vaibhavs10/incredibly-fast-whisper
# -----------------------------------------------------------------------------
REPLICATE_API_TOKEN = ""
# Used for Whisper + YouTube/media download fallback (mptamilselvan/download-media)

# -----------------------------------------------------------------------------
# Cloudflare R2 (S3-compatible) — media playback files
# Prefix: videotranscriber/{workspaceId}/...
# MEDIA_RETENTION_DAYS controls media_expires_at (default 30)
# -----------------------------------------------------------------------------
STORAGE_ENDPOINT = ""
STORAGE_REGION = "auto"
STORAGE_ACCESS_KEY_ID = ""
STORAGE_SECRET_ACCESS_KEY = ""
# Also accepted: STORAGE_ACCESS_KEY / STORAGE_SECRET_KEY
STORAGE_BUCKET = ""
STORAGE_DOMAIN = ""
MEDIA_RETENTION_DAYS = "30"
# Optional: override ffmpeg binary (defaults to ffmpeg-static or system ffmpeg)
# FFMPEG_PATH = "/usr/bin/ffmpeg"

# Google Adsence Code
# https://adsense.com/
NEXT_PUBLIC_GOOGLE_ADCODE = ""

# -----------------------------------------------------------------------------
# Cron (Vercel sends Authorization: Bearer $CRON_SECRET)
# Daily grant of yearly-plan monthly credits
# -----------------------------------------------------------------------------
CRON_SECRET = ""